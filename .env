# Supabase connection for the app. Both values are public by design: they ship inside the app,
# and the database's row-level security rules (supabase/schema.sql) decide what anyone can do.
# Never put the service_role or secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://uenshjtbgjztcgtgywlz.supabase.co
# Project Settings > API Keys: the publishable key (sb_publishable_...) or the legacy "anon public" key.
# While this is empty the app runs on sample data with a demo sign-in.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
